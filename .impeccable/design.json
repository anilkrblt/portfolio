          "ratio": 4.43,
          "note": "Below AA; forbidden by The Faint Stays On The Sheet Rule."
        }
      ]
    }
  },
  "components": [
    {
      "name": "Solid Button",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "The primary action on paper; a deeper fill spreads in from the left.",
      "html": "<button class=\"ds-btn\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"/></svg>CV indir (PDF)</button>",
      "css": ".ds-btn{--fill:var(--c-stock,#4a1f28);--text:var(--c-on-stock,#efe9e3);--press:var(--c-stock-2,#5a2732);position:relative;isolation:isolate;display:inline-flex;min-height:3.25rem;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1.6rem;overflow:hidden;border:1px solid var(--fill);border-radius:0;background:var(--fill);color:var(--text);font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:1rem;font-weight:600;cursor:pointer}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--press);transform:scaleX(0);transform-origin:left;transition:transform 460ms var(--ease-lay,cubic-bezier(.22,1,.36,1))}.ds-btn:hover::before,.ds-btn:focus-visible::before{transform:scaleX(1)}.ds-btn:focus-visible{outline:2px solid var(--c-ink,#241c1e);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "The secondary action on paper; strong rule border, Dove Raised press.",
      "html": "<button class=\"ds-btn ds-btn-ghost\">Canlı ürünü incele</button>",
      "css": ".ds-btn{--fill:var(--c-stock,#4a1f28);--text:var(--c-on-stock,#efe9e3);--press:var(--c-stock-2,#5a2732);position:relative;isolation:isolate;display:inline-flex;min-height:3.25rem;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1.6rem;overflow:hidden;border:1px solid var(--fill);border-radius:0;background:var(--fill);color:var(--text);font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:1rem;font-weight:600;cursor:pointer}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--press);transform:scaleX(0);transform-origin:left;transition:transform 460ms var(--ease-lay,cubic-bezier(.22,1,.36,1))}.ds-btn:hover::before,.ds-btn:focus-visible::before{transform:scaleX(1)}.ds-btn:focus-visible{outline:2px solid var(--c-ink,#241c1e);outline-offset:3px}.ds-btn-ghost{--fill:transparent;--text:var(--c-ink,#241c1e);--press:var(--c-raised,#dfddd7);border-color:var(--c-rule,#241c1e)}"
    },
    {
      "name": "Paper Button",
      "kind": "button",
      "refersTo": "button-paper",
      "description": "The masthead CV: the lit action on the stock.",
      "html": "<div class=\"ds-desk\"><button class=\"ds-btn ds-btn-paper\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"/></svg>CV</button></div>",
      "css": ".ds-btn{--fill:var(--c-stock,#4a1f28);--text:var(--c-on-stock,#efe9e3);--press:var(--c-stock-2,#5a2732);position:relative;isolation:isolate;display:inline-flex;min-height:3.25rem;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1.6rem;overflow:hidden;border:1px solid var(--fill);border-radius:0;background:var(--fill);color:var(--text);font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:1rem;font-weight:600;cursor:pointer}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--press);transform:scaleX(0);transform-origin:left;transition:transform 460ms var(--ease-lay,cubic-bezier(.22,1,.36,1))}.ds-btn:hover::before,.ds-btn:focus-visible::before{transform:scaleX(1)}.ds-btn:focus-visible{outline:2px solid var(--c-ink,#241c1e);outline-offset:3px}.ds-desk{display:inline-block;padding:1rem;background:var(--c-stock,#4a1f28)}.ds-btn-paper{--fill:var(--c-on-stock,#efe9e3);--text:var(--c-stock,#4a1f28);--press:var(--c-on-stock-muted,#cdbfb9);min-height:2.5rem;padding-inline:1rem;font-size:.94rem}.ds-btn-paper:focus-visible{outline-color:var(--c-on-stock,#efe9e3)}"
    },
    {
      "name": "Switch",
      "kind": "chip",
      "refersTo": "switch-option-active",
      "description": "Language and theme in the masthead; the pressed option fills On Desk.",
      "html": "<div class=\"ds-desk\"><div class=\"ds-switch\" role=\"group\" aria-label=\"Theme\"><button aria-pressed=\"true\">Gündüz</button><button aria-pressed=\"false\">Gece</button></div></div>",
      "css": ".ds-desk{display:inline-block;padding:1rem;background:var(--c-stock,#4a1f28)}.ds-switch{display:inline-flex;border:1px solid var(--c-stock-rule,rgba(239,233,227,.22))}.ds-switch button{min-height:2.1rem;min-width:2.5rem;padding-inline:.7rem;border:0;background:transparent;color:var(--c-on-stock-muted,#cdbfb9);font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.8rem;font-weight:600;cursor:pointer;transition:background-color 180ms ease,color 180ms ease}.ds-switch button:hover{color:var(--c-on-stock,#efe9e3)}.ds-switch button[aria-pressed='true']{background:var(--c-on-stock,#efe9e3);color:var(--c-stock,#4a1f28)}.ds-switch button:focus-visible{outline:2px solid var(--c-on-stock,#efe9e3);outline-offset:3px}"
    },
    {
      "name": "Nav Links",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "Masthead links; the current section draws a rule from the left.",
      "html": "<nav class=\"ds-masthead\" aria-label=\"Sections\"><a class=\"ds-name\" href=\"#\">Anıl Karabulut</a><a class=\"ds-navlink\" href=\"#\">Ürünler</a><a class=\"ds-navlink\" href=\"#\" aria-current=\"true\">Yöntem</a><a class=\"ds-navlink\" href=\"#\">Deneyim</a></nav>",
      "css": ".ds-masthead{display:flex;align-items:center;gap:1.5rem;height:4rem;padding-inline:2rem;background:var(--c-stock,#4a1f28);border-bottom:1px solid var(--c-stock-rule,rgba(239,233,227,.22))}.ds-name{margin-right:auto;color:var(--c-on-stock,#efe9e3);font-family:var(--font-letter,Spectral,Georgia,serif);font-size:1.25rem;text-decoration:none}.ds-navlink{position:relative;display:inline-flex;align-items:center;min-height:2.5rem;font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.94rem;font-weight:500;color:var(--c-on-stock-muted,#cdbfb9);text-decoration:none;transition:color 160ms ease}.ds-navlink::after{content:'';position:absolute;left:0;right:0;bottom:.3rem;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform 380ms var(--ease-lay,cubic-bezier(.22,1,.36,1))}.ds-navlink:hover,.ds-navlink[aria-current='true']{color:var(--c-on-stock,#efe9e3)}.ds-navlink[aria-current='true']::after{transform:scaleX(1)}.ds-navlink:focus-visible{outline:2px solid var(--c-on-stock,#efe9e3);outline-offset:3px}"
    },
    {
      "name": "Status Marks",
      "kind": "chip",
      "refersTo": "status-live",
      "description": "A square filled when it holds now, outlined while it is coming; always with its word.",
      "html": "<span class=\"ds-status ds-status-live\">Yayında</span> <span class=\"ds-status ds-status-building\">Geliştiriliyor</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.94rem;font-weight:600;line-height:1.2;white-space:nowrap}.ds-status::before{content:'';width:.6em;height:.6em;flex:none;border:1.5px solid currentColor}.ds-status-live{color:var(--c-alarm,#7a1f2e)}.ds-status-live::before{background:currentColor}.ds-status-building{color:var(--c-ink,#241c1e)}"
    },
    {
      "name": "Enclosure Index",
      "kind": "custom",
      "refersTo": "enclosure-line",
      "description": "The list that closes the first sheet: Ek number, name, and the line's action or state.",
      "html": "<div class=\"ds-index\"><h2 class=\"ds-label\">Ekler</h2><div class=\"ds-rows\"><a class=\"ds-enclosure\" href=\"#\"><span class=\"ds-ek\">Ek 1</span><span>Özgeçmiş</span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"/></svg></a><a class=\"ds-enclosure\" href=\"#\"><span class=\"ds-ek\">Ek 2</span><span>TranslateYourPDF</span><span class=\"ds-status ds-status-live\">Yayında</span></a><a class=\"ds-enclosure\" href=\"#\"><span class=\"ds-ek\">Ek 3</span><span>EAA Monitor</span><span class=\"ds-status ds-status-building\">Geliştiriliyor</span></a><a class=\"ds-enclosure\" href=\"#\"><span class=\"ds-ek\">Ek 5</span><span>Çalışma yöntemi</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14\"/><path d=\"m19 12-7 7-7-7\"/></svg></a></div></div>",
      "css": ".ds-index{max-width:20rem;padding:1.5rem;background:var(--c-canvas,#e9e8e4)}.ds-label{margin:0;padding-bottom:.5rem;font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.75rem;font-weight:600;letter-spacing:.1em;line-height:1.4;text-transform:uppercase;color:var(--c-muted,#5c5352)}.ds-rows{border-top:1px solid var(--c-rule,#241c1e)}.ds-enclosure{display:grid;grid-template-columns:2.75rem minmax(0,1fr) auto;align-items:baseline;gap:.6rem;padding-block:.5rem;border-bottom:1px solid var(--c-rule-soft,rgba(36,28,30,.18));font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.94rem;color:var(--c-ink,#241c1e);text-decoration:none;transition:background-color 200ms ease}.ds-enclosure:hover{background:var(--c-raised,#dfddd7)}.ds-enclosure:focus-visible{outline:2px solid var(--c-ink,#241c1e);outline-offset:3px}.ds-enclosure svg{align-self:center}.ds-ek{color:var(--c-muted,#5c5352)}.ds-status{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.94rem;font-weight:600;line-height:1.2;white-space:nowrap}.ds-status::before{content:'';width:.6em;height:.6em;flex:none;border:1.5px solid currentColor}.ds-status-live{color:var(--c-alarm,#7a1f2e)}.ds-status-live::before{background:currentColor}.ds-status-building{color:var(--c-ink,#241c1e)}.ds-enclosure .ds-status{font-size:.8rem}"
    },
    {
      "name": "Section Head",
      "kind": "custom",
      "description": "A title on the desk, its Ek mark at the right edge on the same baseline, the lead below.",
      "html": "<div class=\"ds-head\"><h2 class=\"ds-headline\">Ürünler</h2><span class=\"ds-ek-mark\">Ek 2–4</span><p class=\"ds-lead\">Canlı ve geliştirilen ürünler.</p></div>",
      "css": ".ds-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:.5rem 2rem;padding:3rem 2rem 2rem;background:var(--c-stock,#4a1f28);color:var(--c-on-stock,#efe9e3)}.ds-headline{margin:0;font-family:var(--font-letter,Spectral,Georgia,serif);font-weight:300;font-size:clamp(2.1rem,4.2vw,3.25rem);line-height:1.08;letter-spacing:-.012em}.ds-ek-mark{font-family:var(--font-form,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:.94rem;font-weight:600;color:var(--c-on-stock-muted,#cdbfb9);white-space:nowrap}.ds-lead{grid-column:1/-1;max-width:34rem;margin:0;color:var(--c-on-stock-muted,#cdbfb9);font-family:var(--font-letter,Spectral,Georgia,serif);font-size:1.125rem}"
    },
    {
      "name": "Sheet with Watermark",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Heavy paper on the desk: square, one soft shadow. The watermark shows where the pointer holds it to the light; here it lights on hover at the centre.",
      "html": "<div class=\"ds-desk-ground\"><div class=\"ds-sheet\"><div class=\"ds-watermark\" aria-hidden=\"true\"><svg viewBox=\"0 0 400 400\" fill=\"none\" stroke=\"currentColor\"><circle cx=\"200\" cy=\"200\" r=\"192\" stroke-width=\"3\"/><circle cx=\"200\" cy=\"200\" r=\"178\" stroke-width=\"1\"/><text x=\"200\" y=\"262\" text-anchor=\"middle\" fill=\"currentColor\" stroke=\"none\" font-family=\"Spectral, Georgia, serif\" font-size=\"176\" font-weight=\"300\">AK</text></svg></div><p class=\"ds-sentence\">Fikirden canlı ürüne, uçtan uca.</p><p class=\"ds-signature\">Saygılarımla,<span>Anıl Karabulut</span></p></div></div>",
      "css": ".ds-desk-ground{padding:2rem;background:var(--c-stock,#4a1f28)}.ds-sheet{position:relative;isolation:isolate;overflow:hidden;padding:3.5rem;background:var(--c-canvas,#e9e8e4);box-shadow:var(--sheet-shadow,0 1px 1px rgba(30,8,14,.3),0 18px 36px -14px rgba(30,8,14,.55))}.ds-watermark{position:absolute;inset:0;z-index:-1;display:grid;place-items:center;color:var(--mark,rgba(36,28,30,.13));opacity:0;transition:opacity 500ms ease;-webkit-mask-image:radial-gradient(circle 17rem at 50% 50%,#000 25%,transparent 100%);mask-image:radial-gradient(circle 17rem at 50% 50%,#000 25%,transparent 100%)}.ds-watermark svg{width:min(82%,46rem);height:auto}.ds-sheet:hover .ds-watermark{opacity:1}.ds-sentence{margin:0;font-family:var(--font-letter,Spectral,Georgia,serif);font-style:italic;font-size:clamp(1.4rem,2.3vw,1.85rem);line-height:1.3;color:var(--c-ink,#241c1e)}.ds-signature{margin:1.5rem 0 0;font-family:var(--font-letter,Spectral,Georgia,serif);font-style:italic;line-height:1.35;color:var(--c-body,#2f2829)}.ds-signature span{display:block;margin-top:.15rem;font-size:1.5rem;font-style:normal}"
    },
    {
      "name": "Clipped Print",
      "kind": "custom",
      "refersTo": "print",
      "description": "The print on the sheet, held by the split paperclip: back half under, front half over; straightens on hover. The clip halves are the project's baked rasters at /clip-back.png and /clip-front.png, served from the site root.",
      "html": "<div class=\"ds-clipped\"><img class=\"ds-clip ds-clip-back\" src=\"/clip-back.png\" alt=\"\" width=\"66\" height=\"198\"><div class=\"ds-print\"><div class=\"ds-photo\"></div></div><img class=\"ds-clip ds-clip-front\" src=\"/clip-front.png\" alt=\"\" width=\"66\" height=\"198\"></div>",
      "css": ".ds-clipped{position:relative;width:12rem;margin:2rem;rotate:1.6deg;transition:rotate 520ms var(--ease-lay,cubic-bezier(.22,1,.36,1))}.ds-clipped:hover{rotate:0deg}.ds-print{position:relative;z-index:1;padding:.5rem;background:var(--print,#f6f5f1);box-shadow:0 1px 2px rgba(30,8,14,.3),0 8px 18px -8px rgba(30,8,14,.45)}.ds-photo{aspect-ratio:4/5;background:var(--c-raised,#dfddd7)}.ds-clip{position:absolute;top:-1.25rem;left:1.5rem;width:1.4rem;height:4.2rem;filter:drop-shadow(.5px 1.2px .7px rgba(30,8,14,.5))}.ds-clip-back{z-index:0}.ds-clip-front{z-index:2}"
    }
  ],
  "narrative": {
    "northStar": "The Letter on the Desk",
    "overview": "The page is a good letter arriving on a manager's desk: heavy stock, a short signed introduction, and its enclosures attached. Everything readable sits on a sheet of paper, and everything between the sheets is the desk. Trust comes from restraint and finish, so the system spends its effort on what a careful stationer would: the weight of the paper, a mark pressed into it without ink, a clip that really holds the photograph, a numbered list of what is enclosed.\n\nDensity is that of correspondence. The first sheet carries the name, the face, the role, the availability, the closing and the index of enclosures. The sheets behind it are records: rows, hairlines, dates, status. Two voices share the work: a serif that writes the letter and a grotesque that fills in the form around it.\n\nThe world has two lights. Gündüz lays dove-grey sheets on vişne çürüğü cotton; Gece turns the whole desk to aubergine with pale ink. The signature belongs to the mouse: moving the pointer over a sheet holds it to the light and the watermark shows.",
    "keyCharacteristics": [
      "A desk and sheets: the page ground is coloured stock, and readable content lies on paper above it.",
      "Spectral for the letter's voice, Hanken Grotesk for the office form around it.",
      "Square corners and hairline rules on every surface and control.",
      "One soft shadow per paper object, faint fibre in the sheet, nothing glossy.",
      "Finish carried by physical marks: the blind monogram, the split paperclip, the hidden watermark, the typed signature.",
      "One numbering across the page: the enclosure index and the section marks count the same Ek 1 to Ek 8.",
      "Motion is a sheet settling once. The page is readable at every frame."
    ],
    "rules": [
      {
        "name": "The State Only Rule",
        "body": "The state colours mark live, available and active, and nothing else. State Vişne on paper, Desk State on the desk, Night State in Gece. If removing the colour leaves the meaning intact, it should not be there.",
        "section": "colors"
      },
      {
        "name": "The Dove Not Cream Rule",
        "body": "The sheet ground is dove grey in every Gündüz surface. Cream is refused; the warm pale of On Desk belongs to text and controls on the stock, not to the paper.",
        "section": "colors"
      },
      {
        "name": "The Faint Stays On The Sheet Rule",
        "body": "Ink Faint is for the sheet ground only. On Dove Raised it falls below AA.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "The letter speaks in Spectral; the form is filled in with Hanken Grotesk. If a string is a sentence, it is Spectral. If it is a field, a value, a date or a control, it is Hanken Grotesk.",
        "section": "typography"
      },
      {
        "name": "The No Spectral Bold Rule",
        "body": "Spectral stops at 500. Anything that needs to be heavier is set in Hanken Grotesk, so the browser never synthesises a weight.",
        "section": "typography"
      },
      {
        "name": "The Field Name Rule",
        "body": "A label names the list or field directly beneath it. It is never a lead-in above a larger heading.",
        "section": "typography"
      },
      {
        "name": "The Paper Only Rule",
        "body": "Shadows belong to objects that are physically paper or wire: the sheet, the print, the clip. Buttons, rows, panels and plates cast none.",
        "section": "elevation"
      },
      {
        "name": "The Marks In The Paper Rule",
        "body": "Fibre, watermark and monogram are in the sheet, not on it. They stay beneath the text and never compete with it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put readable content on a sheet, and keep section titles and the close on the desk.",
      "Do use the semantic tokens, so both themes stay in step.",
      "Do keep one numbering: a new enclosure takes its number in the index and on its section head together.",
      "Do set sentences in Spectral and fields, values, dates and controls in Hanken Grotesk.",
      "Do close a status with its word as well as its mark, so state never rests on colour alone.",
      "Do keep every sheet visible from its first frame; the settle moves it, never reveals it.",
      "Do keep the CV the solid action, reachable from the masthead at every width.",
      "Do keep text at WCAG AA in both themes, and check any new pair in Gündüz and Gece."
    ],
    "donts": [
      "Don't let the sheet ground drift to cream or ivory.",
      "Don't use a state colour for decoration, emphasis, links or hover.",
      "Don't put a label above a heading as a lead-in; a label names a list or a field.",
      "Don't set Spectral heavier than 500.",
      "Don't add corner radius to a surface or control.",
      "Don't paint with gradients, glass or blur; depth is paper, shadow and tone.",
      "Don't give a shadow to anything that is not paper or wire.",
      "Don't imitate a signature with a script font; the name is typed.",
      "Don't give the monogram an ink colour, or redraw it as a flat logo.",
      "Don't tilt a sheet at rest; only the print rests at an angle.",
      "Don't add entrance animations to sections or fade content in.",
      "Don't place Ink Faint on Dove Raised."
    ]
  }
}
