  "components": [
    {
      "name": "Ink Pill",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "Primary action on paper; centre-out Bath Raised spread on hover.",
      "html": "<button class=\"ds-btn\">Visit the product</button>",
      "css": ".ds-btn{--fill:var(--c-ink,#141c45);--text:var(--c-canvas,#eef0ed);--spread:var(--c-ink-press,#24337a);position:relative;isolation:isolate;display:inline-flex;min-height:3.25rem;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1.6rem;overflow:hidden;border:1.5px solid var(--fill);border-radius:999px;background:var(--fill);color:var(--text);font-family:'Bricolage Grotesque',ui-sans-serif,system-ui,sans-serif;font-size:1rem;font-weight:650;letter-spacing:-.005em;cursor:pointer;transition:color 200ms ease,border-color 200ms ease}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--spread);clip-path:circle(0% at 50% 50%);transition:clip-path 520ms cubic-bezier(.16,1,.3,1)}.ds-btn:hover::before,.ds-btn:focus-visible::before{clip-path:circle(75% at 50% 50%)}.ds-btn:focus-visible{outline:2px solid var(--c-ink,#141c45);outline-offset:3px}"
    },
    {
