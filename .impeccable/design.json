      "html": "<div class=\"ds-switch\"><button aria-pressed=\"true\">TR</button><button aria-pressed=\"false\">EN</button></div>",
      "css": ".ds-switch{display:inline-flex;gap:.15rem;padding:.2rem;border:1px solid var(--c-rule-soft,rgba(20,28,69,.2));border-radius:999px}.ds-switch button{min-height:2.1rem;min-width:2.5rem;padding-inline:.7rem;border:0;border-radius:999px;background:transparent;color:var(--c-muted,#4c5374);font-family:'Bricolage Grotesque',ui-sans-serif,sans-serif;font-size:.78rem;font-weight:650;letter-spacing:.02em;cursor:pointer;transition:background-color 180ms ease,color 180ms ease}.ds-switch button:hover{color:var(--c-ink,#141c45)}.ds-switch button[aria-pressed=true]{background:var(--c-ink,#141c45);color:var(--c-canvas,#eef0ed)}.ds-switch button:focus-visible{outline:2px solid var(--c-ink,#141c45);outline-offset:3px}"
    },
